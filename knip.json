{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "src/**/*.test.ts",
    "src/lockerfolio/main.tsx",
    "vite.config.ts",
    "src/scripts/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx,css}"],
  "ignore": ["src/imports/**", "dist/**"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
