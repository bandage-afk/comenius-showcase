{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "deadcode": "knip --no-progress",
    "smoke": "node scripts/smoke.mjs",
    "layout": "node scripts/layout.mjs",
    "e2e": "node scripts/e2e.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "routes": "node scripts/check-routes.mjs",
    "filesize": "node scripts/check-file-size.mjs",
    "workflows": "node scripts/check-workflows.mjs",
    "tokens": "node scripts/check-token-usage.mjs",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update",
    "verify:ui": "node scripts/smoke.mjs && node scripts/layout.mjs && node scripts/e2e.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm routes && pnpm filesize && pnpm workflows && pnpm tokens && pnpm build && pnpm budget",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "oxlint",
      "prettier --write"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "protobufjs"
    ]
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@react-three/rapier": "^2.2.0",
    "@types/three": "^0.185.4",
    "framer-motion": "^13.4.3",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/east-sea-dokdo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/ultra": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
